MAILADK_IMAP_HOST=imap.example.com:993
MAILADK_IMAP_USER=user@example.com
MAILADK_IMAP_PASS=your-password
MAILADK_IMAP_SUBJECT=Identity Verification
MAILADK_SPA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
MAILADK_VERIFIER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
MAILADK_SPA_CALLBACK_URL=https://spa.example.com/auth/callback
MAILADK_POLL_INTERVAL=30s
